{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sukashi comparison report major version 1",
  "type": "object",
  "required": [
    "version",
    "head",
    "seed",
    "plan_seconds",
    "jobs",
    "ok"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "schema_minor": {
      "type": "integer",
      "minimum": 0
    },
    "head": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "plan_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "reason",
          "selected_ids",
          "executed_ids",
          "file_level_count",
          "full_count",
          "full_failures",
          "selected_failures",
          "full_only_failures",
          "inventory_drift",
          "full_only_job",
          "selected_seconds",
          "full_seconds",
          "ok"
        ],
        "properties": {
          "mode": {
            "enum": [
              "full",
              "subset",
              "skip"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_detail": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_ids": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "executed_ids": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "file_level_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "full_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "full_failures": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_failures": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "full_only_failures": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "inventory_drift": {
            "type": "boolean"
          },
          "full_only_job": {
            "type": "boolean"
          },
          "selected_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "full_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "selected_status": {
            "anyOf": [
              {
                "enum": [
                  "passed",
                  "failed",
                  "failed_to_start",
                  "unavailable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "full_status": {
            "anyOf": [
              {
                "enum": [
                  "passed",
                  "failed",
                  "failed_to_start",
                  "unavailable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "selected_only_failures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "missed_failures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "flaky_or_order_dependent": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "unclassified_full_only_failures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "retry_ids": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "retry_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "retry_ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "ok": {
      "type": "boolean"
    },
    "failure_policy": {
      "enum": [
        "strict",
        "missed"
      ]
    }
  },
  "additionalProperties": true
}
